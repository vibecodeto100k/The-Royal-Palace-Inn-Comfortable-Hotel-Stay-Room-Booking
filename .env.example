# Server & Port Configuration
PORT=3000
NODE_ENV=development

# Authentication Secret
JWT_SECRET="YOUR_SECURE_RANDOM_SECRET_KEY"

# Optional External Database (e.g. Supabase / Cloud SQL PostgreSQL)
# If left empty, the built-in persistent SQLite database is automatically used.
DATABASE_URL=""

# Optional Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional Official WhatsApp Business Platform (Mode B)
# For standard Mode A (Click-to-Chat), no API tokens are required.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_API_TOKEN=""

# Google Maps Platform API Key
# Automatically injected by AI Studio when configured
VITE_GOOGLE_MAPS_API_KEY=""

# App & AI Studio URLs
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
